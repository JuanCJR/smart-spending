// Prisma schema for Smart Spending backend.
// NOTE (back-0 / homologar-stack): base infrastructure only, no domain models yet.
// Domain models (e.g. Expense) arrive with the `registrar-gasto` spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
