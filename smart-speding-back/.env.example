# Copy to .env for local development (docker-compose provides this Postgres).
# See docker-compose.yml — service `db` on localhost:5432.
DATABASE_URL="postgresql://smart_spending:smart_spending@localhost:5432/smart_spending?schema=public"

# HTTP server port (optional, defaults to 3000)
PORT=3000

# Allowed origin for the frontend (CORS)
FRONTEND_ORIGIN="http://localhost:5173"
